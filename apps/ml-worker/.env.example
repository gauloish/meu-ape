# ==============================================================================
# ML-Worker Environment Variables (Example Configuration)
# ==============================================================================

# Geocoding API Key (obtained from geocoding-api service)
GEO_API_KEY=geocoding_secret_key_change_me
GEO_API_URL=http://host.docker.internal:8002

# Requests variables
TIMEOUT=15.0
MAX_RETRIES=5
BACKOFF_FACTOR=2.0

# Hugging Face Token
HF_TOKEN=hf_token_change_me

# Training Variables
N_TRIALS=20
K_FOLDS=5
DATASET_SOURCE="user/dataset_repo_name"
REPO_ID="user/model_repo_name"

