# ==============================================================================
# Geocoding API Environment Variables (Example Configuration)
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=geocoding_secure_pass_123
POSTGRES_HOST=cache_db
POSTGRES_PORT=5432
POSTGRES_DB=geocoding_database
POSTGRES_HOST_PORT=5432

# Database Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Nominatim Service Configuration
NOMINATIM_URL=http://nominatim_server:8080
NOMINATIM_HOST_PORT=8080

# FastAPI Application Configuration
API_PORT=8000
LOG_LEVEL=INFO
USER_AGENT=GeocodingAPI/1.0