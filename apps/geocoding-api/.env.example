# ==============================================================================
# Geocoding API Environment Variables (Example Configuration)
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=geocoding_secure_pass_123
POSTGRES_HOST=cache_db
POSTGRES_PORT=5432
POSTGRES_DB=geocoding_database
POSTGRES_HOST_PORT=5432

# Database Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Nominatim Service Configuration
NOMINATIM_URL=http://nominatim_server:8080
NOMINATIM_HOST_PORT=8080

# FastAPI Application Configuration
API_PORT=8000
LOG_LEVEL=INFO
USER_AGENT=GeocodingAPI/1.0

# Security (SecOps) & Tiered API Keys
GEO_API_KEY_APP=geocoding_secret_key_change_me_opakk
GEO_API_KEY_ML=geocoding_ml_secret_key_change_me

# Rate Limiting - Consumo Comum (Backend da Aplicação)
RATE_LIMIT_APP_DEFAULT=60/minute
RATE_LIMIT_APP_BATCH=10/minute

# Rate Limiting - Treinamento ML (Pipelines em Lote / High Throughput)
RATE_LIMIT_ML_DEFAULT=600/minute
RATE_LIMIT_ML_BATCH=120/minute