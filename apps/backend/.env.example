# ==============================================================================
# Backend API Environment Variables (Example Configuration)
# ==============================================================================

# Hugging Face Hub Configuration
# HF_TOKEN é obrigatório se o repositório for privado; pode ser omitido/em branco se for público
HF_TOKEN=hf_token_change_me
REPO_ID=user/model_repo_name
MODEL_FILENAME=model.joblib

# Diretório de cache opcional para downloads do Hugging Face Hub
# Deixe em branco para usar o diretório padrão (~/.cache/huggingface/hub)
HF_CACHE_DIR=

# Server Configuration
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# CORS Configuration (separado por vírgula ou * para permitir todos)
CORS_ORIGINS=*
